            <key>safariAllowJavaScript</key>
            <true/>
            <key>safariAllowPopups</key>
            <false/>
            <key>safariForceFraudWarning</key>
            <true/>
        </dict>

        <!-- ======================================================
             03 — WEB CONTENT FILTER
             ====================================================== -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.webcontent-filter</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.lifestudio.mdm.igecko8.webcontentfilter</string>
            <key>PayloadUUID</key>
            <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6003</string>
            <key>PayloadDisplayName</key>
            <string>iGecko8 — Shield Web Filter</string>
            <key>PayloadDescription</key>
            <string>Extreme website protection. Automatically blocks unsafe, unverified and known malware or phishing hosts. Whitelist and blacklist based filtering with socket-level inspection.</string>
            <key>PayloadOrganization</key>
            <string>LifeStudio MDM Services Inc</string>
            <key>FilterType</key>
            <string>BuiltIn</string>
            <key>UserDefinedName</key>
            <string>iGecko8 Shield</string>
            <key>AutoFilterEnabled</key>
            <true/>
            <key>URLFilterEnabled</key>
            <true/>
            <key>FilterSockets</key>
            <true/>
            <key>FilterPackets</key>
            <true/>
            <key>FilterGrade</key>
            <string>firewall</string>
            <key>FilterDataProviderBundleIdentifier</key>
            <string>com.lifestudio.mdm.igecko8.shield</string>
            <key>FilterDataProviderDesignatedRequirement</key>
            <string>anchor apple generic and identifier "com.lifestudio.mdm.igecko8.shield"</string>
            <key>PermittedURLs</key>
            <array>
                <string>https://*.apple.com</string>
                <string>https://*.icloud.com</string>
                <string>https://*.lifestudio.example</string>
            </array>
            <key>BlacklistedURLs</key>
            <array>
                <string>*.doubleclick.net</string>
                <string>*.adservice.google.com</string>
                <string>*.tracker.example</string>
                <string>*.malwaredomainlist.example</string>
                <string>*.phish-test.example</string>
            </array>
            <key>WhitelistedBookmarks</key>
            <array>
                <dict>
                    <key>Title</key>
                    <string>LifeStudio MDM Services Inc</string>
                    <key>URL</key>
                    <string>https://lifestudio.example</string>
                </dict>
                <dict>
                    <key>Title</key>
                    <string>iGecko8 Support</string>
                    <key>URL</key>
                    <string>https://lifestudio.example/igecko8/support</string>
                </dict>
            </array>
        </dict>

        <!-- ======================================================
             04 — DNS SETTINGS (Encrypted DNS)
             ====================================================== -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.lifestudio.mdm.igecko8.dns</string>
            <key>PayloadUUID</key>
            <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6004</string>
            <key>PayloadDisplayName</key>
            <string>iGecko8 — Encrypted DNS</string>
            <key>PayloadDescription</key>
            <string>Forces all DNS traffic through an encrypted DoH resolver with malware and phishing blocking enabled. Prevents DNS hijacking and spoofing.</string>
            <key>PayloadOrganization</key>
            <string>LifeStudio MDM Services Inc</string>
            <key>DNSProtocol</key>
            <string>HTTPS</string>
            <key>ServerURL</key>
            <string>https://dns.lifestudio.example/dns-query</string>
            <key>ServerURLs</key>
            <array>
                <string>https://dns.lifestudio.example/dns-query</string>
                <string>https://dns2.lifestudio.example/dns-query</string>
            </array>
            <key>ServerAddresses</key>
            <array>
                <string>10.64.0.10</string>
                <string>10.64.0.11</string>
            </array>
            <key>SupplementalMatchDomains</key>
            <array>
                <string>lifestudio.example</string>
                <string>igecko8.example</string>
            </array>
            <key>DNSSettingsEnabled</key>
            <true/>
        </dict>

        <!-- ======================================================
             05 — VPN (IKEv2, Always-On)
             ====================================================== -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.vpn.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.lifestudio.mdm.igecko8.vpn</string>
            <key>PayloadUUID</key>
            <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6005</string>
            <key>PayloadDisplayName</key>
            <string>iGecko8 — Secure Tunnel</string>
            <key>PayloadDescription</key>
            <string>Always-on IKEv2 tunnel with perfect forward secrecy and certificate revocation checking. All device traffic is encrypted and inspected.</string>
            <key>PayloadOrganization</key>
            <string>LifeStudio MDM Services Inc</string>
            <key>UserDefinedName</key>
            <string>iGecko8 Secure Tunnel</string>
            <key>VPNType</key>
            <string>IKEv2</string>
            <key>VPNSubType</key>
            <string>com.apple.ikev2</string>
            <key>VendorConfig</key>
            <dict/>
            <key>VPN</key>
            <dict>
                <key>AuthenticationMethod</key>
                <string>Certificate</string>
                <key>RemoteAddress</key>
                <string>vpn.lifestudio.example</string>
                <key>LocalIdentifier</key>
                <string>igecko8-client</string>
                <key>RemoteIdentifier</key>
                <string>vpn.lifestudio.example</string>
                <key>ServerCertificateIssuerCommonName</key>
                <string>LifeStudio MDM Root CA</string>
                <key>ServerCertificateCommonName</key>
                <string>vpn.lifestudio.example</string>
                <key>PayloadCertificateUUID</key>
                <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6007</string>
                <key>ExtendedAuthEnabled</key>
                <integer>0</integer>
                <key>DisableRedirect</key>
                <true/>
                <key>EnablePFS</key>
                <true/>
                <key>EnableCertificateRevocationCheck</key>
                <true/>
                <key>IKESecurityAssociationParameters</key>
                <dict>
                    <key>EncryptionAlgorithm</key>
                    <string>AES-256-GCM</string>
                    <key>IntegrityAlgorithm</key>
                    <string>SHA2-512</string>
                    <key>DiffieHellmanGroup</key>
                    <integer>21</integer>
                    <key>LifetimeInMinutes</key>
                    <integer>60</integer>
                </dict>
                <key>ChildSecurityAssociationParameters</key>
                <dict>
                    <key>EncryptionAlgorithm</key>
                    <string>AES-256-GCM</string>
                    <key>IntegrityAlgorithm</key>
                    <string>SHA2-512</string>
                    <key>DiffieHellmanGroup</key>
                    <integer>21</integer>
                    <key>LifetimeInMinutes</key>
                    <integer>30</integer>
                </dict>
            </dict>
            <key>OnDemandEnabled</key>
            <integer>1</integer>
            <key>OnDemandRules</key>
            <array>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>WiFi</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Cellular</string>
                </dict>
                <dict>
                    <key>Action</key>
                    <string>Connect</string>
                    <key>InterfaceTypeMatch</key>
                    <string>Any</string>
                </dict>
            </array>
            <key>OverridePrimary</key>
            <integer>1</integer>
        </dict>

        <!-- ======================================================
             06 — WI-FI
             ====================================================== -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.lifestudio.mdm.igecko8.wifi</string>
            <key>PayloadUUID</key>
            <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6006</string>
            <key>PayloadDisplayName</key>
            <string>iGecko8 — Secure Wi-Fi</string>
            <key>PayloadDescription</key>
            <string>Trusted corporate Wi-Fi network using WPA3 Enterprise with certificate based authentication. Auto-join is restricted to verified access points only.</string>
            <key>PayloadOrganization</key>
            <string>LifeStudio MDM Services Inc</string>
            <key>SSID_STR</key>
            <string>LifeStudio-Secure</string>
            <key>HIDDEN_NETWORK</key>
            <false/>
            <key>AutoJoin</key>
            <true/>
            <key>EncryptionType</key>
            <string>WPA3</string>
            <key>Password</key>
            <string>iGecko8-Secure-WPA3-Key</string>
            <key>ProxyType</key>
            <string>None</string>
            <key>DisableAssociationMACRandomization</key>
            <true/>
            <key>TLSCertificateRequired</key>
            <true/>
        </dict>

