<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    ============================================================
     iGecko8 — Mobile Configuration
     Created By : LifeStudio MDM Services Inc
     Security   : Extreme
     Supports   : iOS / Android (profile install)
     Purpose    : Faster Performance, Extreme Security,
                  Jailbreak-Resistant, Malware-Free
     NOTE       : Installing this profile will restart the device
                  so that all system-level changes can be applied.
    ============================================================
-->
<plist version="1.0">
<dict>

    <!-- ==========================================================
         PAYLOAD CONTENT
         ========================================================== -->
    <key>PayloadContent</key>
    <array>

        <!-- ======================================================
             01 — PASSCODE POLICY
             ====================================================== -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.mobiledevice.passwordpolicy</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.lifestudio.mdm.igecko8.passcode</string>
            <key>PayloadUUID</key>
            <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6001</string>
            <key>PayloadDisplayName</key>
            <string>iGecko8 — Passcode Policy</string>
            <key>PayloadDescription</key>
            <string>Enforces an alphanumeric passcode with history, complexity and aging requirements. Blocks simple passcodes and delays brute-force attempts.</string>
            <key>PayloadOrganization</key>
            <string>LifeStudio MDM Services Inc</string>
            <key>allowSimple</key>
            <false/>
            <key>forcePIN</key>
            <true/>
            <key>changeAtNextAuth</key>
            <true/>
            <key>maxFailedAttempts</key>
            <integer>6</integer>
            <key>maxGracePeriod</key>
            <integer>0</integer>
            <key>maxInactivity</key>
            <integer>2</integer>
            <key>maxPINAgeInDays</key>
            <integer>30</integer>
            <key>minComplexChars</key>
            <integer>4</integer>
            <key>minLength</key>
            <integer>8</integer>
            <key>pinHistory</key>
            <integer>12</integer>
            <key>requireAlphanumeric</key>
            <true/>
            <key>allowFingerprintForUnlock</key>
            <true/>
            <key>allowFingerprintModification</key>
            <false/>
        </dict>

        <!-- ======================================================
             02 — RESTRICTIONS (Application Access)
             ====================================================== -->
        <dict>
            <key>PayloadType</key>
            <string>com.apple.applicationaccess</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.lifestudio.mdm.igecko8.restrictions</string>
            <key>PayloadUUID</key>
            <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6002</string>
            <key>PayloadDisplayName</key>
            <string>iGecko8 — Restrictions</string>
            <key>PayloadDescription</key>
            <string>Locks down system features, blocks sideloading, untrusted enterprise apps and unmanaged data flow. Core of the Jailbreak-Resistant layer.</string>
            <key>PayloadOrganization</key>
            <string>LifeStudio MDM Services Inc</string>

            <key>allowAccountModification</key>
            <false/>
            <key>allowAirDrop</key>
            <false/>
            <key>allowAirPrint</key>
            <true/>
            <key>allowAirPrintCredentialsStorage</key>
            <false/>
            <key>allowAppCellularDataModification</key>
            <false/>
            <key>allowAppClips</key>
            <false/>
            <key>allowAppInstallation</key>
            <false/>
            <key>allowAppRemoval</key>
            <false/>
