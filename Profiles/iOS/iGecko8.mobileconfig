    <!-- ==========================================================
         TOP LEVEL PROFILE KEYS
         ========================================================== -->
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadIdentifier</key>
    <string>com.lifestudio.mdm.igecko8</string>
    <key>PayloadUUID</key>
    <string>7C9E1A20-3B4D-4F6E-9A1B-2C3D4E5F6000</string>
    <key>PayloadDisplayName</key>
    <string>iGecko8</string>
    <key>PayloadDescription</key>
    <string>iGecko8 — Mobile Configuration. Applies system and feature level changes, then restarts the device so that every change can take effect. Created by LifeStudio MDM Services Inc. Provides faster and more responsive performance, extreme security for unsafe or unverified websites that may contain malware or viruses, and a Jailbreak-Resistant layer that keeps the device 100 percent computer and jailbreak app free.</string>
    <key>PayloadOrganization</key>
    <string>LifeStudio MDM Services Inc</string>
    <key>PayloadRemovalDisallowed</key>
    <true/>
    <key>HasRemovalPasscode</key>
    <true/>
    <key>PayloadScope</key>
    <string>System</string>
    <key>ConsentText</key>
    <dict>
        <key>en</key>
        <string>iGecko8 by LifeStudio MDM Services Inc. This configuration applies extreme security, performance and jailbreak-resistance settings to your device. Your device will restart once the profile is installed so the changes can be applied. By continuing you agree to the LifeStudio MDM Services Inc device policy.</string>
        <key>default</key>
        <string>iGecko8 by LifeStudio MDM Services Inc. Extreme security, performance and jailbreak-resistance configuration. Your device will restart to apply changes.</string>
    </dict>
    <key>PayloadDisplayNameLocale</key>
    <string>en</string>

</dict>
