
---

## 📄 `.gitignore`

```gitignore
# ============================================================
# iGecko8 — Git ignore rules
# ============================================================

# ---------- OS files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak

# ---------- Secrets & certificates ----------
# Never commit real private keys, provisioning profiles, or keystores.
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer
*.der
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
secrets/
.env
.env.*
*.local

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Node / npm ----------
node_modules/
package-lock.json
yarn.lock
dist/
build/
coverage/

# ---------- Android build artifacts ----------
*.apk
*.aab
*.ap_
*.dex
*.class
.gradle/
local.properties
captures/
.externalNativeBuild/
.cxx/

# ---------- iOS build artifacts ----------
*.ipa
*.dSYM.zip
*.dSYM
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.xccheckout

# ---------- Python (optional) ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---------- Temporary ----------
tmp/
temp/
*.tmp
*.temp
*.orig
*.rej
